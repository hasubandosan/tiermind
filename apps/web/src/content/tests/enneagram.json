  "items": [
    {
      "id": "enn_1",
      "text": "Я стремлюсь делать всё правильно и безупречно",
      "scale": "1",
      "reverse": false
    },
    {
      "id": "enn_2",
      "text": "Меня раздражает несправедливость и несовершенство",
      "scale": "1",
      "reverse": false
    },
    {
      "id": "enn_3",
      "text": "Мне важно быть нужным и полезным для других",
      "scale": "2",
      "reverse": false
    },
    {
      "id": "enn_4",
      "text": "Я легко замечаю, что нужно другим людям",
      "scale": "2",
      "reverse": false
    },
    {
      "id": "enn_5",
      "text": "Мой успех — это главная мера моей ценности",
      "scale": "3",
      "reverse": false
    },
    {
      "id": "enn_6",
      "text": "Я ставлю амбициозные цели и стремлюсь их достичь",
      "scale": "3",
      "reverse": false
    },
    {
      "id": "enn_7",
      "text": "Я чувствую себя особенным и непохожим на других",
      "scale": "4",
      "reverse": false
    },
    {
      "id": "enn_8",
      "text": "Я часто испытываю ностальгию или тоску по идеалу",
      "scale": "4",
      "reverse": false
    },
    {
      "id": "enn_9",
      "text": "Мне нужно уединение, чтобы восстановить силы",
      "scale": "5",
      "reverse": false
    },
    {
      "id": "enn_10",
      "text": "Я предпочитаю наблюдать со стороны, прежде чем действовать",
      "scale": "5",
      "reverse": false
    },
    {
      "id": "enn_11",
      "text": "Я часто представляю худшие сценарии развития событий",
      "scale": "6",
      "reverse": false
    },
    {
      "id": "enn_12",
      "text": "Мне важно чувствовать поддержку и защиту",
      "scale": "6",
      "reverse": false
    },
    {
      "id": "enn_13",
      "text": "Я люблю новые впечатления и боюсь скуки",
      "scale": "7",
      "reverse": false
    },
    {
      "id": "enn_14",
      "text": "Я предпочитаю фокусироваться на позитиве",
      "scale": "7",
      "reverse": false
    },
    {
      "id": "enn_15",
      "text": "Мне важно контролировать ситуацию и быть сильным",
      "scale": "8",
      "reverse": false
    },
    {
      "id": "enn_16",
      "text": "Я не боюсь конфронтации и могу постоять за себя",
      "scale": "8",
      "reverse": false
    },
    {
      "id": "enn_17",
      "text": "Я избегаю конфликтов и стремлюсь к гармонии",
      "scale": "9",
      "reverse": false
    },
    {
      "id": "enn_18",
      "text": "Мне трудно определить, чего я действительно хочу",
      "scale": "9",
      "reverse": false
    }
  ]
}
